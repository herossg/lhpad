#include <windows.h>
#include "version.h"
1 ICON "../data/LHPad.ico"
1 RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION LHPAD_VERSION_MAJOR,LHPAD_VERSION_MINOR,LHPAD_VERSION_PATCH,0
 PRODUCTVERSION LHPAD_VERSION_MAJOR,LHPAD_VERSION_MINOR,LHPAD_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "LHPad contributors\0"
   VALUE "FileDescription", "LHPad native text and Hex editor\0"
   VALUE "FileVersion", LHPAD_VERSION_STRING "\0"
   VALUE "InternalName", "LHPad\0"
   VALUE "LegalCopyright", "GPL-3.0-or-later\0"
   VALUE "OriginalFilename", "LHPad.exe\0"
   VALUE "ProductName", "LHPad\0"
   VALUE "ProductVersion", LHPAD_VERSION_STRING " C++\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
